# =============================================================================
# GBA / BBMP Ward & Engineer Platform — environment variables
# Copy to `.env` and fill in. NEVER commit `.env`.
# =============================================================================

# --- Supabase (client-side, safe to expose) --------------------------------
# Project URL from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Publishable / anon key (Dashboard → Project Settings → API → Project API keys)
# Used by the browser + server components for RLS-protected reads/writes.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Supabase (server-only secrets — used by scripts, NEVER shipped to client)
# Service-role key (Dashboard → Project Settings → API → service_role).
# Bypasses RLS. Used only by the seed script and admin user creation.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_or_service_role_jwt_xxxxxxxxxxxx

# Direct Postgres connection string for migrations + seeding.
# Dashboard → Project Settings → Database → Connection string → URI
# (use the "Session" pooler or direct connection; include your DB password).
# Example: postgresql://postgres:[PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# The app applies any pending supabase/migrations/*.sql file to DATABASE_URL
# automatically on every server boot (lib/startup/migrations.ts). That's
# convenient in dev but unsafe unattended in production (a bad migration file
# or a mid-incident restart could alter schema or crash-loop the app). Default:
# runs automatically unless NODE_ENV=production. Set explicitly to override in
# either direction:
#   RUN_MIGRATIONS_ON_BOOT=true   always auto-migrate on boot, even in production
#   RUN_MIGRATIONS_ON_BOOT=false  never auto-migrate on boot; use `npm run db:migrate`
RUN_MIGRATIONS_ON_BOOT=

# Similarly, the app seeds reference data on boot (lib/startup/seed.ts) — this
# is idempotent (checks row counts first) and skipped by default in production
# unless explicitly forced:
#   SEED_ON_STARTUP=true   force seeding to run even when NODE_ENV=production
SEED_ON_STARTUP=

# --- Cloudflare R2 object storage (REQUIRED) -------------------------------
# Primary store for ALL complaint documents, department replies, counter-reply
# and escalation PDFs, and forensic-import evidence. The app THROWS on upload if
# these are missing — set every one of the five before deploying.
# Create an R2 bucket + an R2 API token (Account → R2 → Manage API Tokens).
R2_ACCOUNT_ID=                              # Cloudflare account ID (endpoint is https://<id>.r2.cloudflarestorage.com)
R2_ACCESS_KEY_ID=                           # R2 API token access key
R2_SECRET_ACCESS_KEY=                       # R2 API token secret
R2_BUCKET_NAME=gba-bbmp-tracker             # bucket name
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev   # bucket public base URL (used to build object URLs)

# --- AI drafting (Phase 2) — OPTIONAL --------------------------------------
# The app works fully WITHOUT these: AI buttons show "AI not configured" and the
# manual templates still work. Keys are read ONLY from env, never the database.
# Provider: anthropic (default) | openai. Default model: claude-sonnet-4-6.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Only needed when AI_PROVIDER=openai.
OPENAI_API_KEY=
AI_MODEL=claude-sonnet-4-6
AI_TEMPERATURE=0.4

# Anthropic prompt caching (lib/ai/provider.ts + cache-config.ts) — reuses the
# system prompt / case-history prefix across repeat Claude calls (the AI
# Advisor re-analysing a complaint, multi-letter/multi-document import loops,
# the escalation ladder's back-to-back reminder+legal-notice+CM-letter drafts).
# Default enabled. Set to false to revert every AI call to its pre-caching
# request shape — no other code changes needed.
ANTHROPIC_PROMPT_CACHE=true

# --- Puppeteer / Chromium (PDF generation + OCR page rendering) ------------
# Path to a Chrome/Chromium binary. The production Docker image installs system
# Chromium and sets this to /usr/bin/chromium automatically. On Windows dev the
# app auto-detects a local Chrome install, so this is usually left blank there.
PUPPETEER_EXECUTABLE_PATH=

# --- Scheduled notifications (app/api/cron/notifications) — OPTIONAL ----------
# Point any scheduler at GET/POST /api/cron/notifications with the secret header
# (x-cron-secret) or ?secret=. It computes overdue RTIs/complaints + due
# reminders. If NOTIFY_WEBHOOK_URL is set, the digest is POSTed there (e.g. a
# Make.com webhook that fans out WhatsApp/SMS/email — same pattern as pujya_sri).
# Without these, the route returns the digest JSON and sends nothing.
CRON_SECRET=
NOTIFY_WEBHOOK_URL=

# --- Gmail SMTP: emailing filed letters to officials (server-only) — OPTIONAL -
# When a letter is filed, the app emails it (with the PDF attached) to the officer
# responsible for that complaint. Off unless MAIL_ENABLED is exactly "true".
#
# GMAIL_APP_PASSWORD is NOT the account password. Google requires an App Password:
# turn on 2-Step Verification for the sending account, then generate one at
# https://myaccount.google.com/apppasswords and paste the 16 characters here.
# Google displays it in four groups; the spaces are stripped automatically.
# Keep this in .env / .env.local ONLY — never in app_settings, which is
# world-readable (0003_phase2.sql), and never committed.
MAIL_ENABLED=false
GMAIL_USER=rti.gba@gmail.com
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=GBA / BBMP Complaint Tracker
MAIL_REPLY_TO=rti.gba@gmail.com

# SMTP port. Default 587 (STARTTLS), NOT 465 — consumer antivirus that intercepts
# SMTP tends to break 465. Measured on the dev machine: Norton Web/Mail Shield
# re-signs port 465 with a root named "Norton Web/Mail Shield Untrusted Root",
# which is deliberately not in the Windows trust store, so the handshake fails with
# UNABLE_TO_VERIFY_LEAF_SIGNATURE and no client setting can fix it. On 587 the same
# product signs with its trusted root and the chain validates. Set 465 only if a
# deployment specifically wants implicit TLS.
MAIL_SMTP_PORT=587

# ⚠ TEST MODE — THE SAFETY SWITCH. While this holds an address, EVERY letter
# email is diverted to it and officials are never contacted; the intended
# recipients are recorded in letter_emails.intended_to and printed in the body.
# Going live is a deliberate act: you must DELETE this line. There is no way to
# reach an official by adding something.
MAIL_REDIRECT_TO=mani96462@gmail.com

# --- MCP server (mcp/bbmp-server.ts) — no extra vars needed -------------------
# The MCP server reuses NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above.
# When running from the project root (npm run mcp:start), dotenv reads .env
# automatically — no extra configuration needed.
#
# For Claude Code: create .claude/settings.json in the project root:
#   {
#     "mcpServers": {
#       "bbmp": {
#         "command": "npx",
#         "args": ["tsx", "mcp/bbmp-server.ts"],
#         "cwd": "D:/Tatvam/BBMP",
#         "env": {}
#       }
#     }
#   }
#
# For Claude Desktop: add to ~/AppData/Roaming/Claude/claude_desktop_config.json:
#   {
#     "mcpServers": {
#       "bbmp": {
#         "command": "npx",
#         "args": ["tsx", "D:/Tatvam/BBMP/mcp/bbmp-server.ts"],
#         "env": {
#           "NEXT_PUBLIC_SUPABASE_URL": "https://YOUR-PROJECT.supabase.co",
#           "SUPABASE_SERVICE_ROLE_KEY": "your-service-role-jwt"
#         }
#       }
#     }
#   }

# --- Web Push (VAPID) — phone notifications for the Android app / PWA ---------
# Generate a key pair once, then paste both values here:
#   npx web-push generate-vapid-keys
#
# The PUBLIC key is NEXT_PUBLIC_ because the browser needs it as
# applicationServerKey when subscribing (components/nav/push-toggle.tsx). The
# server reads that same var, so there is no second public copy to keep in sync.
# The PRIVATE key signs pushes and must never reach the client.
#
# Rotating these invalidates every stored subscription in push_subscriptions —
# existing devices keep 410-ing until each user re-enables alerts, so rotate
# only if the private key leaks.
#
# With these unset, push is simply inert: the toggle hides itself and the cron
# route skips the push fan-out (email + webhook are unaffected).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact identifier sent with every push, required by the VAPID spec so a push
# service can reach whoever operates the sender. mailto: or https: URL.
VAPID_SUBJECT=mailto:you@example.org
